#!/usr/bin/env bash
# stitchlab-flash-pico — commission or update the SKR Pico from the Pi itself.
#
# Two paths, both offline (a freshly imaged Pi in AP mode has no internet):
#
#   1. BOOTSEL: a blank RP2040 only accepts UF2 over USB mass storage. Plug the
#      Pico into a Pi USB port while holding BOOTSEL; this script copies
#      Katapult onto it. Needed exactly once per board.
#   2. UART: once Katapult is on the Pico, Klipper is flashed over
#      /dev/serial0 — the same wires Klipper talks on. No cable, no jumper.
#
# Running it with no arguments does the right thing: it looks for a Pico in
# BOOTSEL mode, and otherwise goes straight to the UART path.

set -euo pipefail

FW_DIR="${PICO_FIRMWARE_DIR:-/home/pi/firmware}"
SERIAL="${PICO_FIRMWARE_SERIAL:-/dev/serial0}"
BAUD="${PICO_FIRMWARE_BAUD:-115200}"

KATAPULT_UF2="${FW_DIR}/katapult.uf2"
KLIPPER_BIN="${FW_DIR}/klipper.bin"
KLIPPER_UF2="${FW_DIR}/klipper.uf2"
# Bootloader-free build: the only .uf2 that boots without Katapult behind it.
KLIPPER_STANDALONE_UF2="${FW_DIR}/klipper-standalone.uf2"

FLASHTOOL="/home/pi/katapult/scripts/flashtool.py"
PY="/home/pi/klippy-env/bin/python"

BOOTSEL_LABEL="RPI-RP2"
BOOTSEL_WAIT="${BOOTSEL_WAIT:-120}"
MOUNTPOINT="/run/stitchlab-pico-bootsel"

MODE="auto"
case "${1:-}" in
    --bootsel) MODE="bootsel" ;;
    --uart)    MODE="uart" ;;
    --standalone) MODE="standalone" ;;
    -h|--help)
        sed -n '2,20p' "$0" | sed 's/^# \{0,1\}//'
        cat <<'USAGE'

Usage:
  stitchlab-flash-pico              Commission a Pico: BOOTSEL if present, then UART
  stitchlab-flash-pico --bootsel    Only write Katapult via USB BOOTSEL
  stitchlab-flash-pico --uart       Only write Klipper via Katapult over UART
  stitchlab-flash-pico --standalone Write Klipper directly via BOOTSEL, no Katapult
                                    (recovery path; later updates need BOOTSEL again)
USAGE
        exit 0
        ;;
    "") ;;
    *) echo "Unknown option: $1 (try --help)" >&2; exit 2 ;;
esac

say()  { printf '\n\033[1m%s\033[0m\n' "$*"; }
info() { printf '  %s\n' "$*"; }
fail() { printf '\n\033[31mERROR: %s\033[0m\n' "$*" >&2; exit 1; }

require_file() {
    [ -s "$1" ] || fail "$1 is missing or empty. Was this image built by CI with the firmware job?"
}

# --- Klipper must let go of the UART before we can use it -------------------
KLIPPER_WAS_ACTIVE=0
release_serial() {
    if systemctl is-active --quiet klipper; then
        KLIPPER_WAS_ACTIVE=1
        info "Stopping klipper (it holds ${SERIAL})"
        sudo systemctl stop klipper
    fi
}
restore_klipper() {
    if [ "$KLIPPER_WAS_ACTIVE" = "1" ]; then
        info "Starting klipper again"
        sudo systemctl start klipper || true
    fi
}
trap restore_klipper EXIT

# --- BOOTSEL path -----------------------------------------------------------
find_bootsel_device() {
    # udev creates this link without any probing, so it needs no root and no
    # blkid cache. Unprivileged `blkid -L` only works via this same link;
    # `sudo blkid -L` can additionally probe if udev has not run yet.
    local dev
    dev="$(readlink -f "/dev/disk/by-label/${BOOTSEL_LABEL}" 2>/dev/null || true)"
    if [ -n "$dev" ] && [ -b "$dev" ]; then
        echo "$dev"
        return 0
    fi
    dev="$(blkid -L "$BOOTSEL_LABEL" 2>/dev/null || true)"
    # -n: never prompt for a password from inside the poll loop
    [ -n "$dev" ] || dev="$(sudo -n blkid -L "$BOOTSEL_LABEL" 2>/dev/null || true)"
    [ -n "$dev" ] && echo "$dev"
    return 0
}

wait_for_bootsel() {
    local dev deadline
    dev="$(find_bootsel_device)"
    if [ -n "$dev" ]; then
        echo "$dev"
        return 0
    fi

    # Callers capture this function's stdout as the device path, so every
    # message here has to go to stderr or it ends up inside "$dev".
    {
        say "Plug in the Pico in BOOTSEL mode"
        info "1. Unplug the USB cable from the Pico, if connected"
        info "2. Hold down the BOOTSEL button on the Pico"
        info "3. Plug the Pico into a USB port of the Pi"
        info "4. Release BOOTSEL"
        info ""
        info "Waiting up to ${BOOTSEL_WAIT}s for a drive labelled ${BOOTSEL_LABEL} ..."
    } >&2

    deadline=$(( $(date +%s) + BOOTSEL_WAIT ))
    while [ "$(date +%s)" -lt "$deadline" ]; do
        dev="$(find_bootsel_device)"
        if [ -n "$dev" ]; then
            echo "$dev"
            return 0
        fi
        sleep 2
    done
    return 1
}

flash_via_bootsel() {
    local uf2="$1" label="$2" dev
    require_file "$uf2"

    if ! dev="$(wait_for_bootsel)"; then
        fail "No ${BOOTSEL_LABEL} drive found. Is the USB cable seated, and was BOOTSEL held while plugging in?"
    fi
    info "Found: ${dev}"

    sudo mkdir -p "$MOUNTPOINT"
    sudo mount "$dev" "$MOUNTPOINT"
    # The RP2040 reboots the instant the UF2 is written, which tears the mount
    # down under us — so unmount failures here are expected, not errors.
    sudo cp "$uf2" "${MOUNTPOINT}/" || true
    sync || true
    sudo umount "$MOUNTPOINT" 2>/dev/null || true
    sudo rmdir "$MOUNTPOINT" 2>/dev/null || true

    # The only reliable success signal is the drive going away: the RP2040
    # reboots into the new code the moment the last UF2 block lands. A drive
    # that is still there means nothing (or not everything) was written.
    local waited=0
    while [ -n "$(find_bootsel_device)" ]; do
        if [ "$waited" -ge 15 ]; then
            fail "${BOOTSEL_LABEL} is still mounted after writing ${uf2}. The write did not complete — check the cable and retry."
        fi
        sleep 1
        waited=$((waited + 1))
    done

    info "${label} written — the Pico rebooted."
    sleep 5
}

# --- UART path --------------------------------------------------------------
flash_via_uart() {
    require_file "$KLIPPER_BIN"
    [ -f "$FLASHTOOL" ] || fail "${FLASHTOOL} is missing (Katapult module not installed?)"
    [ -x "$PY" ]        || fail "${PY} is missing (Klipper venv not installed?)"
    [ -e "$SERIAL" ]    || fail "${SERIAL} does not exist. Check enable_uart=1 and dtoverlay=disable-bt in /boot/firmware/config.txt."

    say "Flashing Klipper over ${SERIAL} (${BAUD} baud)"

    # flashtool occasionally misses the first serial resync on the RP2040
    # (known timing quirk, seen on stitchlab07). Retry before giving up.
    local attempt
    for attempt in 1 2 3; do
        info "Attempt ${attempt}/3 ..."
        # A Pico that already runs Klipper answers only after it has been
        # asked to reboot into Katapult. flashtool sends that request over a
        # plain UART only with -r, so do it explicitly; on a Pico that is
        # already in Katapult the request is ignored.
        sudo "$PY" "$FLASHTOOL" -d "$SERIAL" -b "$BAUD" -r >/dev/null 2>&1 || true
        sleep 2
        if sudo "$PY" "$FLASHTOOL" -d "$SERIAL" -b "$BAUD" -f "$KLIPPER_BIN"; then
            info "Klipper firmware written."
            return 0
        fi
        sleep 3
    done
    fail "Flashing over UART failed after 3 attempts. Is Katapult on the Pico? If not: stitchlab-flash-pico --bootsel"
}

# --- Verification -----------------------------------------------------------
verify_mcu() {
    say "Checking whether Klipper sees the MCU"
    sudo systemctl restart klipper
    KLIPPER_WAS_ACTIVE=0   # we just started it ourselves
    sleep 8

    local log="/home/pi/printer_data/logs/klippy.log"
    if [ -f "$log" ] && tail -n 200 "$log" | grep -q "MCU 'mcu' config"; then
        info "OK — MCU connected."
        return 0
    fi

    printf '\n\033[33mMCU not confirmed yet.\033[0m Last lines of klippy.log:\n\n'
    tail -n 15 "$log" 2>/dev/null || echo "  (no klippy.log)"
    printf '\nSee docs/11-commissioning.md, section "The MCU does not answer".\n'
    return 1
}

# --- Main -------------------------------------------------------------------
say "StitchLAB SKR Pico Firmware"
info "Firmware:  ${FW_DIR}"
info "Serial:    ${SERIAL} @ ${BAUD}"

case "$MODE" in
    bootsel)
        release_serial
        flash_via_bootsel "$KATAPULT_UF2" "Katapult"
        ;;
    uart)
        release_serial
        flash_via_uart
        verify_mcu || true
        ;;
    standalone)
        release_serial
        flash_via_bootsel "$KLIPPER_STANDALONE_UF2" "Klipper (standalone, no Katapult)"
        verify_mcu || true
        ;;
    auto)
        release_serial
        if dev="$(wait_for_bootsel)"; then
            info "Found ${BOOTSEL_LABEL} at ${dev} — writing Katapult."
            flash_via_bootsel "$KATAPULT_UF2" "Katapult"
        else
            say "No Pico appeared in BOOTSEL mode within ${BOOTSEL_WAIT}s"
            info "Continuing over the UART, assuming Katapult is already on the Pico."
            info "If that is not the case, run 'stitchlab-flash-pico --bootsel'."
        fi
        flash_via_uart
        verify_mcu || true
        ;;
esac

say "Done."
