#!/usr/bin/env bash
# stitchlab-flash-pico — commission or update the SKR Pico from the Pi itself.
#
# Two paths, both offline (a freshly imaged Pi in AP mode has no internet):
#
#   1. BOOTSEL: a blank RP2040 only accepts UF2 over USB mass storage. Plug the
#      Pico into a Pi USB port while holding BOOTSEL; this script copies
#      Katapult onto it. Needed exactly once per board.
#   2. UART: once Katapult is on the Pico, Klipper is flashed over
#      /dev/serial0 — the same wires Klipper talks on. No cable, no jumper.
#
# Running it with no arguments does the right thing: it looks for a Pico in
# BOOTSEL mode, and otherwise goes straight to the UART path.

set -euo pipefail

FW_DIR="${PICO_FIRMWARE_DIR:-/home/pi/firmware}"
SERIAL="${PICO_FIRMWARE_SERIAL:-/dev/serial0}"
BAUD="${PICO_FIRMWARE_BAUD:-115200}"

KATAPULT_UF2="${FW_DIR}/katapult.uf2"
KLIPPER_BIN="${FW_DIR}/klipper.bin"
KLIPPER_UF2="${FW_DIR}/klipper.uf2"
# Bootloader-free build: the only .uf2 that boots without Katapult behind it.
KLIPPER_STANDALONE_UF2="${FW_DIR}/klipper-standalone.uf2"

FLASHTOOL="/home/pi/katapult/scripts/flashtool.py"
PY="/home/pi/klippy-env/bin/python"

BOOTSEL_LABEL="RPI-RP2"
BOOTSEL_WAIT="${BOOTSEL_WAIT:-120}"
MOUNTPOINT="/run/stitchlab-pico-bootsel"

MODE="auto"
case "${1:-}" in
    --bootsel) MODE="bootsel" ;;
    --uart)    MODE="uart" ;;
    --standalone) MODE="standalone" ;;
    -h|--help)
        sed -n '2,20p' "$0" | sed 's/^# \{0,1\}//'
        cat <<'USAGE'

Usage:
  stitchlab-flash-pico              Commission a Pico: BOOTSEL if present, then UART
  stitchlab-flash-pico --bootsel    Only write Katapult via USB BOOTSEL
  stitchlab-flash-pico --uart       Only write Klipper via Katapult over UART
  stitchlab-flash-pico --standalone Write Klipper directly via BOOTSEL, no Katapult
                                    (recovery path; later updates need BOOTSEL again)
USAGE
        exit 0
        ;;
    "") ;;
    *) echo "Unknown option: $1 (try --help)" >&2; exit 2 ;;
esac

say()  { printf '\n\033[1m%s\033[0m\n' "$*"; }
info() { printf '  %s\n' "$*"; }
fail() { printf '\n\033[31mFEHLER: %s\033[0m\n' "$*" >&2; exit 1; }

require_file() {
    [ -s "$1" ] || fail "$1 fehlt oder ist leer. Gehört dieses Image zu einem CI-Build mit Firmware-Job?"
}

# --- Klipper must let go of the UART before we can use it -------------------
KLIPPER_WAS_ACTIVE=0
release_serial() {
    if systemctl is-active --quiet klipper; then
        KLIPPER_WAS_ACTIVE=1
        info "Stoppe klipper (hält ${SERIAL})"
        sudo systemctl stop klipper
    fi
}
restore_klipper() {
    if [ "$KLIPPER_WAS_ACTIVE" = "1" ]; then
        info "Starte klipper wieder"
        sudo systemctl start klipper || true
    fi
}
trap restore_klipper EXIT

# --- BOOTSEL path -----------------------------------------------------------
find_bootsel_device() {
    blkid -L "$BOOTSEL_LABEL" 2>/dev/null || true
}

wait_for_bootsel() {
    local dev deadline
    dev="$(find_bootsel_device)"
    if [ -n "$dev" ]; then
        echo "$dev"
        return 0
    fi

    say "Pico im BOOTSEL-Modus anstecken"
    info "1. USB-Kabel vom Pico abziehen (falls gesteckt)"
    info "2. BOOTSEL-Taste am Pico gedrückt halten"
    info "3. Pico per USB an einen USB-Port des Pi stecken"
    info "4. BOOTSEL loslassen"
    info ""
    info "Warte bis zu ${BOOTSEL_WAIT}s auf ein Laufwerk mit Label ${BOOTSEL_LABEL} ..."

    deadline=$(( $(date +%s) + BOOTSEL_WAIT ))
    while [ "$(date +%s)" -lt "$deadline" ]; do
        dev="$(find_bootsel_device)"
        if [ -n "$dev" ]; then
            echo "$dev"
            return 0
        fi
        sleep 2
    done
    return 1
}

flash_via_bootsel() {
    local uf2="$1" label="$2" dev
    require_file "$uf2"

    if ! dev="$(wait_for_bootsel)"; then
        fail "Kein ${BOOTSEL_LABEL}-Laufwerk gefunden. Sitzt das USB-Kabel, wurde BOOTSEL beim Einstecken gehalten?"
    fi
    info "Gefunden: ${dev}"

    sudo mkdir -p "$MOUNTPOINT"
    sudo mount "$dev" "$MOUNTPOINT"
    # The RP2040 reboots the instant the UF2 is written, which tears the mount
    # down under us — so unmount failures here are expected, not errors.
    sudo cp "$uf2" "${MOUNTPOINT}/" || true
    sync || true
    sudo umount "$MOUNTPOINT" 2>/dev/null || true
    sudo rmdir "$MOUNTPOINT" 2>/dev/null || true

    info "${label} geschrieben — der Pico startet jetzt neu."
    sleep 5
}

# --- UART path --------------------------------------------------------------
flash_via_uart() {
    require_file "$KLIPPER_BIN"
    [ -f "$FLASHTOOL" ] || fail "${FLASHTOOL} fehlt (Katapult-Modul nicht installiert?)"
    [ -x "$PY" ]        || fail "${PY} fehlt (Klipper-venv nicht installiert?)"
    [ -e "$SERIAL" ]    || fail "${SERIAL} existiert nicht. enable_uart=1 und dtoverlay=disable-bt in /boot/firmware/config.txt prüfen."

    say "Flashe Klipper über ${SERIAL} (${BAUD} Baud)"

    # flashtool occasionally misses the first serial resync on the RP2040
    # (known timing quirk, seen on stitchlab07). Retry before giving up.
    local attempt
    for attempt in 1 2 3; do
        info "Versuch ${attempt}/3 ..."
        if sudo "$PY" "$FLASHTOOL" -d "$SERIAL" -b "$BAUD" -f "$KLIPPER_BIN"; then
            info "Klipper-Firmware geschrieben."
            return 0
        fi
        sleep 3
    done
    fail "Flashen über UART nach 3 Versuchen fehlgeschlagen. Ist Katapult auf dem Pico? Sonst: stitchlab-flash-pico --bootsel"
}

# --- Verification -----------------------------------------------------------
verify_mcu() {
    say "Prüfe, ob Klipper den MCU sieht"
    sudo systemctl restart klipper
    KLIPPER_WAS_ACTIVE=0   # we just started it ourselves
    sleep 8

    local log="/home/pi/printer_data/logs/klippy.log"
    if [ -f "$log" ] && tail -n 200 "$log" | grep -q "MCU 'mcu' config"; then
        info "OK — MCU verbunden."
        return 0
    fi

    printf '\n\033[33mMCU noch nicht bestätigt.\033[0m Letzte Zeilen aus klippy.log:\n\n'
    tail -n 15 "$log" 2>/dev/null || echo "  (kein klippy.log)"
    printf '\nSiehe docs/11-inbetriebnahme.md, Abschnitt "MCU meldet sich nicht".\n'
    return 1
}

# --- Main -------------------------------------------------------------------
say "StitchLAB SKR Pico Firmware"
info "Firmware:  ${FW_DIR}"
info "Serial:    ${SERIAL} @ ${BAUD}"

case "$MODE" in
    bootsel)
        release_serial
        flash_via_bootsel "$KATAPULT_UF2" "Katapult"
        ;;
    uart)
        release_serial
        flash_via_uart
        verify_mcu || true
        ;;
    standalone)
        release_serial
        flash_via_bootsel "$KLIPPER_STANDALONE_UF2" "Klipper (standalone, ohne Katapult)"
        verify_mcu || true
        ;;
    auto)
        release_serial
        if [ -n "$(find_bootsel_device)" ]; then
            info "Pico ist bereits im BOOTSEL-Modus — schreibe Katapult."
            flash_via_bootsel "$KATAPULT_UF2" "Katapult"
        else
            say "Kein Pico im BOOTSEL-Modus gefunden"
            info "Wenn auf dem Pico bereits Katapult läuft, geht es direkt über UART weiter."
            info "Sonst jetzt abbrechen (Ctrl-C) und 'stitchlab-flash-pico --bootsel' ausführen."
            sleep 5
        fi
        flash_via_uart
        verify_mcu || true
        ;;
esac

say "Fertig."
