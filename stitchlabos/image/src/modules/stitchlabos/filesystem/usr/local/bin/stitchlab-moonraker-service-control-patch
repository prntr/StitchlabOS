#!/usr/bin/env bash
# StitchLabOS — allow Moonraker to start/stop inactive allowed services.
#
# Current Moonraker builds read moonraker.asvc into _allowed_services, but the
# machine.services RPC still rejects allowed services that are not present in
# the systemd provider's available_services map. A static, inactive unit such
# as live_jogd.service is installed and allowed, but not listed there until it
# has already been started. This patch lets Moonraker ask systemd to start,
# stop, or restart services that are explicitly listed in moonraker.asvc.

set -eu

MACHINE_PY="/home/pi/moonraker/moonraker/components/machine.py"

if [ ! -f "${MACHINE_PY}" ]; then
    exit 0
fi

python3 - "${MACHINE_PY}" <<'PY'
from pathlib import Path
import sys

path = Path(sys.argv[1])
text = path.read_text()

old = '''        elif self.sys_provider.is_service_available(name):
            await self.do_service_action(action, name)
        else:
            if name in self._allowed_services:
                raise self.server.error(f"Service '{name}' not installed")
            raise self.server.error(
                f"Service '{name}' not allowed")
'''

new = '''        elif self.sys_provider.is_service_available(name):
            await self.do_service_action(action, name)
        elif name in self._allowed_services:
            await self.do_service_action(action, name)
        else:
            raise self.server.error(
                f"Service '{name}' not allowed")
'''

if new in text:
    sys.exit(0)

if old not in text:
    print("[service-control-patch] machine.py shape changed - skipping.", file=sys.stderr)
    sys.exit(0)

path.write_text(text.replace(old, new, 1))
print("[service-control-patch] applied: allowed inactive services can be controlled")
PY
