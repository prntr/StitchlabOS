#!/usr/bin/env bash
# StitchLabOS - Final Customizations Module
# WiFi manager, embroidery macros, and system configuration

set -e
source /common.sh

echo "=== StitchLabOS: Applying final customizations ==="

# Install additional packages for WiFi management
apt-get update
# Note: do NOT install standalone dnsmasq — it conflicts with NetworkManager's
# internal dnsmasq used for AP shared mode (both bind port 53).
apt-get install -y avahi-daemon

# Unpack system config files (dnsmasq-shared.d, etc.)
unpack /filesystem/etc /etc root
# Moonraker components under usr/local/lib/stitchlabos; symlinked below.
unpack /filesystem/usr /usr root

# Clone stitchlabos-config (wifi_manager, intake glue, scripts, macros) at the
# commit the meta-repo pins as a submodule, so a tag always rebuilds the same
# image. stitchlab-clone-at-ref (klipper module) keeps `main` tracking
# origin/main, which update_manager ([update_manager stitchlabos]) needs.
: "${STITCHLABOS_CONFIG_REF:?not set - CI passes the stitchlabos-config submodule commit (build-image.yml)}"
echo "Cloning stitchlabos-config at ${STITCHLABOS_CONFIG_REF}..."
sudo -u pi /usr/local/bin/stitchlab-clone-at-ref https://github.com/prntr/stitchlabos-config.git main \
    "${STITCHLABOS_CONFIG_REF}" /home/pi/stitchlabos-config

# Create symlinks from stitchlabos-config to expected locations
ln -sf /home/pi/stitchlabos-config/moonraker/components/wifi_manager.py \
    /home/pi/moonraker/moonraker/components/wifi_manager.py
ln -sf /home/pi/stitchlabos-config/moonraker/components/stitchlab_intake.py \
    /home/pi/moonraker/moonraker/components/stitchlab_intake.py
ln -sf /usr/local/lib/stitchlabos/moonraker/stitchlab_ws_tuning.py \
    /home/pi/moonraker/moonraker/components/stitchlab_ws_tuning.py
ln -sf /home/pi/stitchlabos-config/printer_data/config/embroidery_macros.cfg \
    /home/pi/printer_data/config/embroidery_macros.cfg
for script in wifi_status.sh wifi_scan.sh wifi_profiles.sh; do
    ln -sf /home/pi/stitchlabos-config/printer_data/scripts/$script \
        /home/pi/printer_data/scripts/$script
done

# Make WiFi scripts executable
chmod +x /home/pi/stitchlabos-config/printer_data/scripts/wifi_*.sh

# Add [wifi_manager] to moonraker.conf if not present
if ! grep -q '\[wifi_manager\]' /home/pi/printer_data/config/moonraker.conf 2>/dev/null; then
    echo "" >> /home/pi/printer_data/config/moonraker.conf
    echo "# === STITCHLABOS: WiFi Manager ===" >> /home/pi/printer_data/config/moonraker.conf
    echo "# Custom Moonraker component for WiFi management via AccessPopup/NetworkManager" >> /home/pi/printer_data/config/moonraker.conf
    echo "[wifi_manager]" >> /home/pi/printer_data/config/moonraker.conf
fi

# Add [stitchlab_intake] to moonraker.conf if not present
if ! grep -q '\[stitchlab_intake\]' /home/pi/printer_data/config/moonraker.conf 2>/dev/null; then
    echo "" >> /home/pi/printer_data/config/moonraker.conf
    echo "# === STITCHLABOS: G-Code Intake ===" >> /home/pi/printer_data/config/moonraker.conf
    echo "# Pre-flight G-code compatibility checks + cached stick-job thumbnails." >> /home/pi/printer_data/config/moonraker.conf
    echo "[stitchlab_intake]" >> /home/pi/printer_data/config/moonraker.conf
    echo "cli_path: /usr/local/bin/stitchlab-gcode-intake" >> /home/pi/printer_data/config/moonraker.conf
    echo "hoops_config: /home/pi/stitchlab_intake/hoops.json" >> /home/pi/printer_data/config/moonraker.conf
    echo "gcodes_root: /home/pi/printer_data/gcodes" >> /home/pi/printer_data/config/moonraker.conf
    echo "worker_nice: 10" >> /home/pi/printer_data/config/moonraker.conf
    echo "worker_ionice: idle" >> /home/pi/printer_data/config/moonraker.conf
    echo "analyze_timeout: 60" >> /home/pi/printer_data/config/moonraker.conf
    echo "prepare_timeout: 30" >> /home/pi/printer_data/config/moonraker.conf
fi

# Add [stitchlab_ws_tuning] to moonraker.conf if not present
if ! grep -q '\[stitchlab_ws_tuning\]' /home/pi/printer_data/config/moonraker.conf 2>/dev/null; then
    echo "" >> /home/pi/printer_data/config/moonraker.conf
    echo "# === STITCHLABOS: WebSocket ping tuning ===" >> /home/pi/printer_data/config/moonraker.conf
    echo "# Tolerates Wi-Fi jitter in AP mode; see docs/runbooks/ap-troubleshooting.md Issue 5." >> /home/pi/printer_data/config/moonraker.conf
    echo "[stitchlab_ws_tuning]" >> /home/pi/printer_data/config/moonraker.conf
    echo "websocket_ping_interval: 30" >> /home/pi/printer_data/config/moonraker.conf
    echo "websocket_ping_timeout: 25" >> /home/pi/printer_data/config/moonraker.conf
fi

# Configure Avahi for wlan0 only (prevents mDNS issues in AP mode)
if [ -f /etc/avahi/avahi-daemon.conf ]; then
    sed -i 's/^#allow-interfaces=.*/allow-interfaces=wlan0/' /etc/avahi/avahi-daemon.conf
    sed -i 's/^#enable-reflector=no/enable-reflector=yes/' /etc/avahi/avahi-daemon.conf
    # If allow-interfaces line doesn't exist, add it
    if ! grep -q '^allow-interfaces=' /etc/avahi/avahi-daemon.conf; then
        sed -i '/^\[server\]/a allow-interfaces=wlan0' /etc/avahi/avahi-daemon.conf
    fi
fi

# Set default hostname (user can override via Pi Imager)
echo "${STITCHLABOS_HOSTNAME}" > /etc/hostname
sed -i "s/127.0.1.1.*/127.0.1.1\t${STITCHLABOS_HOSTNAME}/" /etc/hosts

# Ensure the baked-in pi account is interactive. Some Raspberry Pi OS images
# keep the first user on nologin until userconf-pi runs on first boot.
if ! id -u pi >/dev/null 2>&1; then
    useradd -m -s /bin/bash pi
else
    usermod -s /bin/bash pi
fi
usermod -aG sudo,dialout,tty,video pi

# Set default password for pi user ("lab") so SSH works out-of-box
echo "pi:lab" | chpasswd

# Enable SSH for headless access
systemctl enable ssh

# Enable UART for SKR Pico connection (GPIO14/15 ↔ Pico UART)
# - enable_uart=1: activates the hardware UART on GPIO14/15
# - disable-bt overlay: frees the PL011 UART from Bluetooth (gives it to GPIO pins)
# - Remove console=serial0 from cmdline.txt so UART is free for Klipper
if [ -f /boot/firmware/config.txt ]; then
    if ! grep -q 'enable_uart=1' /boot/firmware/config.txt; then
        sed -i '/^\[all\]/a enable_uart=1\ndtoverlay=disable-bt' /boot/firmware/config.txt
    fi
fi
if [ -f /boot/firmware/cmdline.txt ]; then
    sed -i 's/console=serial0,[0-9]* //' /boot/firmware/cmdline.txt
    # Prevent Plymouth from sending boot splash data to the hardware UART,
    # which corrupts the SKR Pico's serial state and blocks Klipper MCU init.
    if ! grep -q 'plymouth.ignore-serial-consoles' /boot/firmware/cmdline.txt; then
        sed -i 's/$/ quiet splash plymouth.ignore-serial-consoles/' /boot/firmware/cmdline.txt
    fi
fi

# Suppress Moonraker "untracked source files" warning for wifi_manager.py symlink.
# .git/info/exclude provides local-only git ignore rules — never overwritten by git pull.
echo "moonraker/components/wifi_manager.py" >> /home/pi/moonraker/.git/info/exclude
echo "moonraker/components/stitchlab_intake.py" >> /home/pi/moonraker/.git/info/exclude
echo "moonraker/components/stitchlab_ws_tuning.py" >> /home/pi/moonraker/.git/info/exclude

# Never edit Moonraker's tracked files here: update_manager refuses to update
# a modified repo ("Update aborted, repo has been modified"). WebSocket ping
# tuning is the stitchlab_ws_tuning component above; service control for the
# inactive live_jogd unit is a moonraker.service drop-in in the live-jogd module.

# Install post-Klipper Wi-Fi powersave-off unit (baked by filesystem/, just enable it)
systemctl enable wlan0-powersave-off.service

# Ensure correct ownership
chown -R pi:pi /home/pi/printer_data
chown -R pi:pi /home/pi/moonraker
chown -R pi:pi /home/pi/stitchlabos-config

echo "=== StitchLabOS customizations complete ==="
