#!/usr/bin/env bash
# StitchLabOS - live_jogd Module
# USB serial bridge daemon for StitchLab Dongle (ESP32-C3)

set -e
source /common.sh

echo "=== StitchLabOS: Installing live_jogd ==="

# Install Python serial dependencies
apt-get update
apt-get install -y python3-serial

# Unpack live_jogd files
unpack /filesystem/home/pi /home/pi pi
unpack /filesystem/etc /etc root

# Create Python virtual environment (use virtualenv, more reliable on Debian Trixie)
cd ${LIVE_JOGD_DIR}
sudo -u pi virtualenv -p python3 venv
sudo -u pi ${LIVE_JOGD_DIR}/venv/bin/pip install --upgrade pip
sudo -u pi ${LIVE_JOGD_DIR}/venv/bin/pip install -r requirements.txt

# Make scripts executable
chmod +x ${LIVE_JOGD_DIR}/dongle_api.py

# Reload udev rules
udevadm control --reload-rules

# Reload systemd so the unit is known. Do *not* enable it: live_jogd is
# user-triggered from the Mainsail Controller menu via Moonraker
# machine.services.start. See P0-2 of the Cross-Platform Mainsail
# Stability plan — autostarting on every boot causes a 3-second respawn
# loop on dongle-less Pis and a continuous ~30 req/s baseline against
# Moonraker even when nobody is using the controller.
systemctl daemon-reload

# Authorise Moonraker to start/stop live_jogd via machine.services RPCs.
# moonraker.asvc is the modern allow-list location.
MOONRAKER_ASVC=/home/pi/printer_data/moonraker.asvc
if [ -f "${MOONRAKER_ASVC}" ]; then
    if ! grep -qx "live_jogd" "${MOONRAKER_ASVC}"; then
        echo "live_jogd" >> "${MOONRAKER_ASVC}"
        chown pi:pi "${MOONRAKER_ASVC}"
    fi
else
    install -o pi -g pi -m 0644 /dev/null "${MOONRAKER_ASVC}"
    echo "live_jogd" >> "${MOONRAKER_ASVC}"
fi

echo "=== live_jogd module complete ==="
echo "NOTE: Service is installed but not enabled. Start from Mainsail Controller menu."
