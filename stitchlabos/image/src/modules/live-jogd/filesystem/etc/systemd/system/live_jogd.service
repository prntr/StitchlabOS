[Unit]
Description=Live Jog Daemon for Klipper
# The daemon's source repo is not public; the runbook is, and the daemon's
# header is on every machine.
Documentation=https://github.com/prntr/StitchlabOS/blob/main/docs/runbooks/pi-services.md#live_jogd
Documentation=file:/home/pi/live_jogd/live_jogd.py
After=klipper.service moonraker.service nginx.service
Requires=klipper.service moonraker.service
# No dongle, no start, decided at once: there is no waiting process that a
# click could kill. A skipped condition leaves the unit inactive, not failed.
ConditionPathExists=/dev/stitchlab-dongle
# No start limit: it counted the user's clicks too, and three of them within
# 300 s left the unit failed (2026-09-28 commissioning run). A crashing
# daemon is slowed down by the growing RestartSec below instead.
StartLimitIntervalSec=0

[Service]
Type=simple
User=pi
Group=pi
WorkingDirectory=/home/pi/live_jogd
ExecStartPre=/home/pi/live_jogd/venv/bin/python3 /home/pi/live_jogd/dongle_api.py --wifi on
ExecStart=/home/pi/live_jogd/venv/bin/python3 /home/pi/live_jogd/live_jogd.py
ExecStopPost=/bin/sh -c '[ -e /dev/stitchlab-dongle ] || exit 0; exec /home/pi/live_jogd/venv/bin/python3 /home/pi/live_jogd/dongle_api.py --wifi off'
# Started by the dongle (SYSTEMD_WANTS in 99-stitchlab-dongle.rules, also at
# boot with the dongle plugged in) or from the Mainsail Controller menu
# (machine.services.start). Intentionally *not* WantedBy=multi-user.target:
# a Pi without a dongle never runs it (P0-2 of the Cross-Platform Mainsail
# Stability plan). Stop in the menu stops it until the next plug-in or boot.
Restart=on-failure
# 3 s, growing to one start every 5 minutes over five failed restarts
# (systemd 254 and later; the image has 257).
RestartSec=3
RestartSteps=5
RestartMaxDelaySec=300

# Give access to serial port
SupplementaryGroups=dialout

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=live_jogd
