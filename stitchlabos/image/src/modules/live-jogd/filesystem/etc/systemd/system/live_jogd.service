[Unit]
Description=Live Jog Daemon for Klipper
# The daemon's source repo is not public; the runbook is, and the daemon's
# header is on every machine.
Documentation=https://github.com/prntr/StitchlabOS/blob/main/docs/runbooks/pi-services.md#live_jogd
Documentation=file:/home/pi/live_jogd/live_jogd.py
After=klipper.service moonraker.service nginx.service
Requires=klipper.service moonraker.service
# Limits crash loops of the daemon itself. The interval must be longer than
# three start cycles: with 60 s, a 33 s cycle never reached the burst and a
# dongle-less Pi restarted for hours (673 times on a beta.4 machine).
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
Type=simple
User=pi
Group=pi
WorkingDirectory=/home/pi/live_jogd
# No dongle is not a failure: give a just-plugged dongle 30 s to enumerate,
# then skip the start. ExecCondition exiting 1 leaves the unit inactive
# without marking it failed, so Restart= does not loop.
ExecCondition=/bin/sh -c 'for i in $(seq 1 30); do [ -e /dev/stitchlab-dongle ] && exit 0; sleep 1; done; echo "No StitchLab dongle at /dev/stitchlab-dongle, not starting"; exit 1'
ExecStartPre=/home/pi/live_jogd/venv/bin/python3 /home/pi/live_jogd/dongle_api.py --wifi on
ExecStart=/home/pi/live_jogd/venv/bin/python3 /home/pi/live_jogd/live_jogd.py
ExecStopPost=/bin/sh -c '[ -e /dev/stitchlab-dongle ] || exit 0; exec /home/pi/live_jogd/venv/bin/python3 /home/pi/live_jogd/dongle_api.py --wifi off'
# Service is user-triggered from the Mainsail Controller menu
# (machine.services.start { service: "live_jogd" }). It is intentionally
# *not* WantedBy=multi-user.target — see P0-2 of the Cross-Platform
# Mainsail Stability plan.
Restart=on-failure
RestartSec=3

# Give access to serial port
SupplementaryGroups=dialout

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=live_jogd
