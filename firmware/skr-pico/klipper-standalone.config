# Klipper firmware config — SKR Pico WITHOUT Katapult (recovery build)
#
# Identical to klipper.config except that the application sits directly at
# 0x10000100, so the resulting .uf2 boots on its own after a BOOTSEL drop.
# Use this only to rescue a board whose Katapult is gone: every later update
# then needs BOOTSEL again, because there is no bootloader to talk to.
CONFIG_LOW_LEVEL_OPTIONS=y
CONFIG_MACH_RPXXXX=y
CONFIG_MACH_RP2040=y
# No bootloader — application starts at 0x10000100 (stage2 at 0x10000000)
CONFIG_RPXXXX_FLASH_START_0100=y
CONFIG_RPXXXX_SERIAL_UART0_PINS_0_1=y
CONFIG_SERIAL_BAUD=115200
