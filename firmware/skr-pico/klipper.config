# Klipper firmware config — BTT SKR Pico V1.0 (RP2040) for StitchLAB Classic
#
# Seed defconfig. CI runs `make olddefconfig` against it and then asserts that
# every symbol below survived (see .github/workflows/build-image.yml).
# Do not hand-edit the generated .config — edit this file.
#
# Wiring contract (must match printer.cfg [mcu]):
#   Pi GPIO14 (TXD) -> Pico GPIO1 (UART0 RX)
#   Pi GPIO15 (RXD) -> Pico GPIO0 (UART0 TX)
#   115200 baud, app flashed at 0x10004000 behind Katapult at 0x10000100
CONFIG_LOW_LEVEL_OPTIONS=y
CONFIG_MACH_RPXXXX=y
CONFIG_MACH_RP2040=y
# 16KiB bootloader -> application at 0x10004000 (Katapult lives below it)
CONFIG_RPXXXX_FLASH_START_4000=y
# UART0 on GPIO0/GPIO1 — the SKR Pico's TFT/serial header
CONFIG_RPXXXX_SERIAL_UART0_PINS_0_1=y
# Must equal `baud:` in printer.cfg. Klipper's default is 250000.
CONFIG_SERIAL_BAUD=115200
