# Katapult bootloader config — BTT SKR Pico V1.0 (RP2040) for StitchLAB Classic
#
# Seed defconfig, same contract as klipper.config. Katapult occupies
# 0x10000100..0x10004000 and hands over to Klipper at 0x10004000.
# Once this is on the Pico, every later Klipper update goes over
# /dev/serial0 — no BOOTSEL jumper, no USB cable.
CONFIG_LOW_LEVEL_OPTIONS=y
CONFIG_MACH_RPXXXX=y
CONFIG_MACH_RP2040=y
CONFIG_RPXXXX_FLASH_START_4000=y
CONFIG_RPXXXX_SERIAL_UART0_PINS_0_1=y
CONFIG_SERIAL_BAUD=115200
