# Umbrella repo ignore rules (StitchLAB workspace)

# OS / editor
.DS_Store
.vscode/
.idea/
MainsailDev.code-workspace
.claude/

# Node / web builds & deps (umbrella-level)
**/node_modules/
**/dist/
**/dev-dist/
**/.vite/
**/.cache/
**/.turbo/
**/.eslintcache
**/coverage/

# Python
**/__pycache__/
**/*.pyc
**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/
**/.venv/
**/venv/

# Docker / misc
**/.docker/

# Runtime / generated machine data (do not version)
virtual-klipper-printer/printer_data/
virtual-klipper-printer/mjpg_streamer_images/

# Firmware/PIO build artifacts
**/.pio/
**/.piolibdeps/
**/.clangd/

# Standalone nested git repo (not a submodule)
virtual-klipper-printer/

# SKR Pico firmware built by CI — regenerable binaries, never in git.
# Seeds live in firmware/skr-pico/*.config; the build writes the artifacts here.
stitchlabos/image/src/modules/pico-firmware/filesystem/home/pi/firmware/*
!stitchlabos/image/src/modules/pico-firmware/filesystem/home/pi/firmware/.gitkeep

# os_list.json is generated per release from os_list.template.json
stitchlabos/image/os_list.json

# CI release staging directory
release-assets/

# Local scratch area per house rules — never tracked
.local/
